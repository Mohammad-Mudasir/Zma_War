generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum CancelledBy {
  USER
  ADMIN
}

/// A person who books appointments.
model User {
  id                     Int      @id @default(autoincrement()) @map("user_id")
  name                   String   @db.VarChar(80)
  email                  String   @unique @db.VarChar(190)
  passwordHash           String   @map("password_hash") @db.VarChar(100)
  emailVerified          Boolean  @default(false) @map("email_verified")
  /// The user's preferred reminder lead time. Null means "use the system default".
  defaultReminderMinutes Int?     @map("default_reminder_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  reservations       Reservation[]
  verificationTokens EmailVerificationToken[]

  @@map("users")
}

/// The single administrator (project owner). Kept apart from users on purpose.
model Admin {
  id           Int      @id @default(autoincrement()) @map("admin_id")
  name         String   @db.VarChar(80)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin")
}

/// A bookable time slot. Times are stored in UTC.
model Appointment {
  id         Int      @id @default(autoincrement()) @map("appointment_no")
  startTime  DateTime @unique @map("start_time")
  endTime    DateTime @map("end_time")
  /// True while an ACTIVE reservation holds this slot.
  isReserved Boolean  @default(false) @map("is_reserved")

  reservations Reservation[]

  @@index([isReserved, startTime])
  @@map("appointments")
}

/// A user's booking of a slot. Cancelled rows are kept as history.
model Reservation {
  id                  Int               @id @default(autoincrement()) @map("reservation_id")
  userId              Int               @map("user_id")
  appointmentId       Int               @map("appointment_no")
  status              ReservationStatus @default(ACTIVE)
  cancelledBy         CancelledBy?      @map("cancelled_by")
  reminderLeadMinutes Int               @default(30) @map("reminder_lead_minutes")
  reminderSentAt      DateTime?         @map("reminder_sent_at")
  reminderAttempts    Int               @default(0) @map("reminder_attempts")
  reminderError       String?           @map("reminder_error") @db.VarChar(255)
  createdByAdmin      Boolean           @default(false) @map("created_by_admin")
  createdAt           DateTime          @default(now()) @map("created_at")
  cancelledAt         DateTime?         @map("cancelled_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([appointmentId, status])
  @@index([status, reminderSentAt])
  @@map("reservations")
}

/// Single-use, time-limited email verification tokens. Only a hash is stored.
model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Key/value store for administrator-configured defaults.
model SystemSetting {
  key   String @id @db.VarChar(64)
  value String @db.VarChar(255)

  @@map("system_settings")
}
